# Modelo das variaveis de producao. Para usar:
#
#   cp .env.prod.example .env.prod
#
# e troque os valores no .env.prod. Este modelo pode ser versionado; o .env.prod
# nunca deve ser.
#
# Nao use ";" na senha: ela entra na connection string da API, onde ";" separa
# os campos.
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca_app
POSTGRES_PASSWORD=troque-esta-senha

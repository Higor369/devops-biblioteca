# Modelo das variaveis de producao. Para usar:
#
#   cp .env.prod.example .env.prod
#
# e troque os valores no .env.prod. Este modelo pode ser versionado; o .env.prod
# nunca deve ser.
#
# Serve aos dois arquivos de producao:
#   docker-compose.prod.yml      simulacao no seu notebook, imagem do Docker Hub
#   docker-compose.prod-aws.yml  a EC2 de verdade, imagem do ECR privado
#
# Nao use ";" na senha: ela entra na connection string da API, onde ";" separa
# os campos.
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca_app
POSTGRES_PASSWORD=troque-esta-senha

# So o docker-compose.prod-aws.yml usa esta: o endpoint Writer do cluster Aurora
# (aba "Connectivity & security" do cluster no console). La o banco nao tem
# senha - o login e por token IAM -, entao o POSTGRES_PASSWORD e ignorado, e o
# POSTGRES_USER precisa ser o usuario liberado na policy da role (postgres).
DB_HOST=nome-do-cluster.cluster-xxxxxxxxxxxx.us-east-2.rds.amazonaws.com

# Tag da imagem publicada pelo CI: o numero da execucao (1, 2, 3...) ou latest.
# Na EC2 este valor e reescrito pelo deploy a cada entrega, e passa a ser o
# registro do que esta no ar. Para voltar para a versao anterior, troque o
# numero e suba de novo.
API_TAG=latest

# So o docker-compose.prod-aws.yml usa esta. Endereco do registry no ECR, no
# formato <conta>.dkr.ecr.<regiao>.amazonaws.com. Fica aqui, e nao dentro do
# compose, para o ID da conta da AWS nao ir para o repositorio.
ECR_REGISTRY=000000000000.dkr.ecr.us-east-2.amazonaws.com

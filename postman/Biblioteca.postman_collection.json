              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Livro Órfão\",\n  \"anoDePublicacao\": 1900,\n  \"autorId\": \"{{$guid}}\",\n  \"generoId\": \"{{generoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []

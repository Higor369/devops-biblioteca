        {
          "name": "Livro com ano no futuro (400)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"anoFuturo\", new Date().getFullYear() + 1);"
                ]
              }
            },
            {

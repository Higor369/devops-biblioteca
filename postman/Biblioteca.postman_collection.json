    {
      "name": "Cenários de erro",
      "description": "Respostas de erro no formato RFC 9457 (`application/problem+json`), sempre com o campo `codigo`.",
      "item": [
        {
          "name": "Autor sem nome (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"codigo = requisicao.invalida\", () => {",
                  "    pm.expect(pm.response.json().codigo).to.eql(\"requisicao.invalida\");",
                  "});",
                  "pm.test(\"Aponta o campo que falhou\", () => pm.expect(pm.response.json().errors).to.have.property(\"Nome\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/autores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Barrado pelas DataAnnotations do DTO, antes de chegar ao caso de uso."
          },
          "response": []
        },
        {
          "name": "Autor com nome curto demais (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"codigo = autor.nome_tamanho_invalido\", () => {",
                  "    pm.expect(pm.response.json().codigo).to.eql(\"autor.nome_tamanho_invalido\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/autores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \" a \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "`\" a \"` tem 3 caracteres e passa na anotação, mas vira `\"a\"` depois de normalizado. Quem recusa é o objeto de valor do domínio."
          },
          "response": []
        },
        {
          "name": "Autor inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"codigo = autor.nao_encontrado\", () => {",
                  "    pm.expect(pm.response.json().codigo).to.eql(\"autor.nao_encontrado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/autores/{{$guid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "autores",
                "{{$guid}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Gênero com nome já cadastrado (409)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Mesmo nome do gênero criado, em maiúsculas: a unicidade ignora a caixa.",
                  "pm.variables.set(\"generoNomeMaiusculo\", (pm.collectionVariables.get(\"generoNome\") || \"\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"codigo = genero.nome_ja_cadastrado\", () => {",
                  "    pm.expect(pm.response.json().codigo).to.eql(\"genero.nome_ja_cadastrado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/generos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "generos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{generoNomeMaiusculo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reenvia o nome guardado em `generoNome` em maiúsculas. Rode *Criar gênero* antes."
          },
          "response": []
        },
        {
          "name": "Livro com autor inexistente (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"codigo = autor.nao_encontrado\", () => {",
                  "    pm.expect(pm.response.json().codigo).to.eql(\"autor.nao_encontrado\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

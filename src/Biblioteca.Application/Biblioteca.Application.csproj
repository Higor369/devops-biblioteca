<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!-- Source generator: o codigo de mapeamento e gerado em tempo de compilacao.
         PrivateAssets porque nada em runtime precisa do pacote. -->
    <PackageReference Include="Riok.Mapperly">
      <!-- PrivateAssets impede o pacote de vazar para quem referencia esta camada,
           mas os assemblies de compilacao continuam disponiveis aqui: o atributo
           [Mapper] precisa ser resolvido pelo compilador. -->
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Biblioteca.Domain\Biblioteca.Domain.csproj" />
    <ProjectReference Include="..\Biblioteca.Domain.Services\Biblioteca.Domain.Services.csproj" />
  </ItemGroup>

</Project>
